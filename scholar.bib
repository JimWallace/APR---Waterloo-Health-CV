@article{Wong2026IPV,
author = {Wong*, Veen and Wallace Jarvis*, Laura and Kamal*, Maham and McNab*, Chris and MacArthur, Cayley and \textbf{James R. Wallace}},
title = {Preventing Intimate Partner Violence through Video Games: Designing a Gender-Transformative Health Intervention for Young Men},
year = {2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3810242},
doi = {10.1145/3810242},
abstract = {Intimate Partner Violence (IPV) prevention efforts have traditionally focused on reactive responses and survivor support, often neglecting proactive strategies that address the gendered root causes of violence. This paper presents the design process of Bold Sky, a gender-transformative interactive narrative game designed to engage young men (ages 18–25) in reflecting on healthy relationships and the social and gender norms that contribute to IPV.to foster healthier relationships and disrupt harmful masculinities Working with an interdisciplinary Advisory Committee of stakeholders, we explored how gender-transformative principles can inform narrative design and game mechanics. Through this design process, we identified five core design strategies including narrative complexity, perspective-shifting mechanics, emotion-driven feedback, and alignment with young men’s lived realities. These findings contribute to broader HCI efforts that explore games as tools for behaviour change, health equity, and critical reflection. Our work demonstrates how digital games can act as engaging gender-transformative environments, offering new avenues for engaging young men in IPV prevention.},
note = {Just Accepted. Journal Impact Factor (2025): 4.0},
journal = {ACM Trans. Comput. Healthcare},
month = apr,
keywords = {Digital Games, Serious Games, Violence Prevention, Intimate Partner Violence, User-Centred Design}
}

