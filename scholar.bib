@inproceedings{wallace2012exploring,
author={\textbf{James R. Wallace} and Pape, Joseph and Chang, Yu-Ling Betty and McClelland, Phillip J and Graham, TC Nicholas and Scott, Stacey D and Hancock, Mark},
